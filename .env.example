# Copy this file to ".env" (same folder) and fill it in. Never commit your real .env.
# Needed only for "Send via email" from the Members screen.
#
# Gmail: Google Account -> Security -> turn on 2-Step Verification -> App passwords -> create one.
# Use that 16-character App password below, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgym@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
MAIL_FROM="GymPass <yourgym@gmail.com>"
